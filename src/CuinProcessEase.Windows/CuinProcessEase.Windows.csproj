<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 底层 Win32 能力实现，仅在 Windows 上可用 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CuinProcessEase.Windows</AssemblyName>
    <RootNamespace>CuinProcessEase.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI Win32_Process：读取进程命令行的官方稳定接口 -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CuinProcessEase.Core\CuinProcessEase.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 允许测试项目直接验证 internal 的 GetProcessTimes 备用路径 -->
    <InternalsVisibleTo Include="CuinProcessEase.Windows.Tests" />
  </ItemGroup>

</Project>
