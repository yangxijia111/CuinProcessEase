<Window x:Class="CuinProcessEase.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CuinProcessEase.App.Converters"
        Title="Cuin ProcessEase"
        Width="1280"
        Height="820"
        MinWidth="1020"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <converters:NullToVisibleConverter x:Key="NullToVisible" />
        <converters:EmptyToVisibleConverter x:Key="EmptyToVisible" />

        <!-- 应用行模板：图标 + 名称 + 进程数 + CPU + 内存 + 安全 + 可信度 -->
        <DataTemplate x:Key="AppRowTemplate">
            <Border Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标（缺失时显示首字母占位） -->
                    <Grid Width="26" Height="26" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.Accent.Subtle}"
                                CornerRadius="6">
                            <TextBlock Text="{Binding IconLetter}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Icon}"
                               Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                    </Grid>

                    <!-- 应用名 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Margin="10,0,8,0"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ProcessCountText}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CpuText}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding MemoryText}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />

                    <!-- 安全状态（用户可读文案 + 状态色；样式来自主题字典，随主题重建） -->
                    <Border Grid.Column="5"
                            Style="{DynamicResource ChipBackground}">
                        <TextBlock Text="{Binding SafetyText}"
                                   Style="{DynamicResource ChipText}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="6"
                               Text="{Binding ConfidenceText}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextAlignment="Right" />

                    <TextBlock Grid.Column="7"
                               Text="›"
                               FontSize="16"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"
                           MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 标题 + 搜索 + 主题 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Cuin ProcessEase"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Border Background="{DynamicResource Brush.Accent.Subtle}"
                        CornerRadius="6"
                        Padding="7,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="应用管理器"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Accent}" />
                </Border>
            </StackPanel>

            <Grid Grid.Column="2"
                  Width="320"
                  VerticalAlignment="Center">
                <TextBox Style="{DynamicResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="搜索应用、进程、路径…"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           IsHitTestVisible="False"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
            </Grid>

            <Button Grid.Column="3"
                    Style="{DynamicResource ToolButton}"
                    Command="{Binding ToggleThemeCommand}"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe UI Emoji">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🌙" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                        <Setter Property="Text" Value="☀️" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
            </Button>
        </Grid>

        <!-- ============ Overview ============ -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.Background}"
                BorderBrush="{DynamicResource Brush.Surface.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,10,0,0"
                Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,26,0">
                    <TextBlock Text="CPU"
                               Style="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OverviewCpu}"
                               Style="{DynamicResource PrimaryText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,26,0">
                    <TextBlock Text="内存"
                               Style="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OverviewMemory}"
                               Style="{DynamicResource PrimaryText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,26,0">
                    <TextBlock Text="应用"
                               Style="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OverviewApplications}"
                               Style="{DynamicResource PrimaryText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="进程"
                               Style="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OverviewProcesses}"
                               Style="{DynamicResource PrimaryText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ 工具栏：筛选页 / 排序 / 锁定 / 暂停 ============ -->
        <Grid Grid.Row="2"
              Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabAll"
                             Style="{DynamicResource SegmentTab}"
                             GroupName="FilterTabs"
                             Content="全部应用"
                             IsChecked="True"
                             Tag="All" />
                <RadioButton x:Name="TabHighResource"
                             Style="{DynamicResource SegmentTab}"
                             GroupName="FilterTabs"
                             Content="高资源"
                             Tag="HighResource" />
                <RadioButton x:Name="TabBackground"
                             Style="{DynamicResource SegmentTab}"
                             GroupName="FilterTabs"
                             Content="后台运行"
                             Tag="Background" />
                <RadioButton x:Name="TabSystem"
                             Style="{DynamicResource SegmentTab}"
                             GroupName="FilterTabs"
                             Content="系统进程"
                             Tag="System" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <TextBlock Text="排序"
                           Style="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Style="{DynamicResource SortComboBox}"
                          ItemContainerStyle="{DynamicResource ComboBoxItemStyle}"
                          SelectedIndex="{Binding SelectedSortIndex}">
                    <ComboBoxItem>名称</ComboBoxItem>
                    <ComboBoxItem>CPU</ComboBoxItem>
                    <ComboBoxItem>内存</ComboBoxItem>
                    <ComboBoxItem>进程数量</ComboBoxItem>
                </ComboBox>
                <CheckBox x:Name="LockListCheck"
                          Style="{DynamicResource ThemeCheckBox}"
                          Content="锁定列表"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center" />
                <CheckBox x:Name="PauseCheck"
                          Style="{DynamicResource ThemeCheckBox}"
                          Content="暂停刷新"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============ 列表 + 详情 ============ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 列头（与行模板列宽一致） -->
                <Grid Margin="10,2,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="名称"
                               Style="{DynamicResource SecondaryText}"
                               FontSize="12"
                               Margin="10,0,8,0" />
                    <TextBlock Grid.Column="2"
                               Text="进程数"
                               Style="{DynamicResource SecondaryText}"
                               FontSize="12"
                               TextAlignment="Right" />
                    <TextBlock Grid.Column="3"
                               Text="CPU"
                               Style="{DynamicResource SecondaryText}"
                               FontSize="12"
                               TextAlignment="Right" />
                    <TextBlock Grid.Column="4"
                               Text="内存"
                               Style="{DynamicResource SecondaryText}"
                               FontSize="12"
                               TextAlignment="Right" />
                    <TextBlock Grid.Column="5"
                               Text="安全"
                               Style="{DynamicResource SecondaryText}"
                               FontSize="12"
                               TextAlignment="Right" />
                    <TextBlock Grid.Column="6"
                               Text="分组"
                               Style="{DynamicResource SecondaryText}"
                               FontSize="12"
                               TextAlignment="Right" />
                </Grid>

                <ListBox Grid.Row="1"
                         x:Name="AppsList"
                         ItemsSource="{Binding Applications}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ItemTemplate="{StaticResource AppRowTemplate}"
                         ItemContainerStyle="{DynamicResource AppRowContainer}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <!-- ============ 详情面板 ============ -->
            <Border Grid.Column="1"
                    Width="370"
                    Margin="12,0,0,0"
                    Background="{DynamicResource Brush.Surface.Background}"
                    BorderBrush="{DynamicResource Brush.Surface.Border}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Visibility="{Binding SelectedRow, Converter={StaticResource NullToCollapsed}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedRow.DisplayName}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextWrapping="Wrap" />
                            <!-- 布局预留：Phase 5 只判断不执行，永久禁用 -->
                            <Button Grid.Column="1"
                                    Style="{DynamicResource ToolButton}"
                                    Content="结束应用"
                                    IsEnabled="False"
                                    ToolTip="Phase 5 仅做判断与展示，不提供结束进程能力"
                                    VerticalAlignment="Top" />
                        </Grid>

                        <!-- 应用信息 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style x:Key="DetailLabel" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                    <Setter Property="Margin" Value="0,3" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </Style>
                                <Style x:Key="DetailValue" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                    <Setter Property="Margin" Value="14,3,0,3" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>

                            <TextBlock Text="主程序" Grid.Row="0" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SelectedRow.Group.Identity.MainExecutable}"
                                       Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="安装目录" Grid.Row="1" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SelectedRow.Group.Identity.InstallDirectory}"
                                       Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="进程数量" Grid.Row="2" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SelectedRow.ProcessCountText}"
                                       Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="总内存" Grid.Row="3" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SelectedRow.MemoryText}"
                                       Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="分组可信度" Grid.Row="4" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SelectedRow.ConfidenceText}"
                                       Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="安全状态" Grid.Row="5" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SelectedRow.SafetyText}"
                                       Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="风险等级" Grid.Row="6" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SelectedRow.RiskLevel}"
                                       Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}" />
                        </Grid>

                        <Separator Margin="0,12,0,8"
                                   Background="{DynamicResource Brush.Surface.Border}" />
                        <TextBlock Style="{DynamicResource SecondaryText}">
                            <Run Text="进程列表（" /><Run Text="{Binding SelectedRow.Processes.Count, Mode=OneWay}" /><Run Text="）" />
                        </TextBlock>

                        <!-- 进程列表（原地更新；展开状态保留在行模型上） -->
                        <ItemsControl ItemsSource="{Binding SelectedRow.Processes}"
                                      Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{DynamicResource ProcessExpander}"
                                              IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid MinWidth="300">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{DynamicResource PrimaryText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="12"
                                                           Margin="8,0,0,0"
                                                           Text="{Binding CpuText}" />
                                                <TextBlock Grid.Column="2"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="12"
                                                           Margin="10,0,0,0"
                                                           Text="{Binding MemoryText}" />
                                                <TextBlock Grid.Column="3"
                                                           Style="{DynamicResource SecondaryText}"
                                                           FontSize="12"
                                                           Margin="10,0,0,0"
                                                           Text="{Binding Pid, StringFormat='PID {0}'}" />
                                            </Grid>
                                        </Expander.Header>
                                        <!-- 高级详情：仅展开时可见 -->
                                        <StackPanel Margin="4,2,0,6">
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12"><Run Text="PPID：    " /><Run Text="{Binding PpidText, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12" TextWrapping="Wrap"><Run Text="路径：    " /><Run Text="{Binding Path, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12"><Run Text="用户：    " /><Run Text="{Binding User, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12"><Run Text="启动：    " /><Run Text="{Binding StartTime, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12"><Run Text="架构：    " /><Run Text="{Binding Architecture, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12"><Run Text="管理员：  " /><Run Text="{Binding Elevated, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12"><Run Text="会话：    " /><Run Text="{Binding Session, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12"><Run Text="安全：    " /><Run Text="{Binding SafetyText, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12"><Run Text="Critical：" /><Run Text="{Binding IsCriticalText, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Style="{DynamicResource SecondaryText}" FontSize="12" TextWrapping="Wrap"><Run Text="保护级别：" /><Run Text="{Binding ProtectionLevelText, Mode=OneWay}" /></TextBlock>

                                            <!-- 命令行：默认不读，点击才走 WMI（不回热路径） -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Style="{DynamicResource ToolButton}"
                                                        Content="读取命令行"
                                                        FontSize="12"
                                                        Command="{Binding LoadCommandLineCommand}"
                                                        IsEnabled="{Binding IsLoadCommandLineEnabled}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding CommandLineText}"
                                                       Style="{DynamicResource SecondaryText}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   Style="{DynamicResource SecondaryText}"
                   FontSize="12"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
