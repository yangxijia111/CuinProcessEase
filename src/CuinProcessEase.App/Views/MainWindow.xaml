<Window x:Class="CuinProcessEase.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CuinProcessEase — Phase 1 进程快照验证"
        Width="1180"
        Height="700"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 等宽字体便于阅读 PID / 路径 -->
        <Style x:Key="RowFont" TargetType="Control">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部工具栏：手动捕获 / 自动刷新开关 / 状态栏 -->
        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Command="{Binding CaptureCommand}"
                        Padding="12,4"
                        Content="捕获快照" />
                <CheckBox DockPanel.Dock="Left"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding AutoRefresh}"
                          Content="自动刷新（1 秒）" />
                <TextBlock VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="12,0,0,0"
                           Text="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <!-- 进程列表：Phase 1 平铺展示全部进程快照 -->
        <ListView ItemsSource="{Binding Processes}"
                  Style="{StaticResource RowFont}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="70" Header="PID" DisplayMemberBinding="{Binding Pid}" />
                    <GridViewColumn Width="70" Header="PPID" DisplayMemberBinding="{Binding Ppid}" />
                    <GridViewColumn Width="170" Header="名称" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Width="330" Header="路径" DisplayMemberBinding="{Binding Path}" />
                    <GridViewColumn Width="150" Header="用户" DisplayMemberBinding="{Binding User}" />
                    <GridViewColumn Width="70" Header="架构" DisplayMemberBinding="{Binding Architecture}" />
                    <GridViewColumn Width="50" Header="提升" DisplayMemberBinding="{Binding Elevated}" />
                    <GridViewColumn Width="50" Header="会话" DisplayMemberBinding="{Binding Session}" />
                    <GridViewColumn Width="85" Header="工作集" DisplayMemberBinding="{Binding WorkingSet}" />
                    <GridViewColumn Width="85" Header="专用内存" DisplayMemberBinding="{Binding PrivateMemory}" />
                    <GridViewColumn Width="70" Header="启动时间" DisplayMemberBinding="{Binding StartTime}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
